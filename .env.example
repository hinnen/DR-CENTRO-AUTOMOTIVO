# Copie para .env e ajuste os valores. Nunca versione o .env.

# Gere com: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=troque-esta-chave

DEBUG=True

ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# PostgreSQL é o banco oficial do projeto.
DATABASE_URL=postgres://oficina:sua-senha@127.0.0.1:5432/oficina
DB_CONN_MAX_AGE=60

WORKSHOP_NAME=DR Centro Automotivo
APP_VERSION=0.0.1

# Upload de fotos
MEDIA_ROOT=
MAX_UPLOAD_SIZE_MB=10

LOG_LEVEL=INFO

# E-mail (usado apenas em produção; nenhuma funcionalidade envia e-mail ainda)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=nao-responda@suaoficina.com.br

# Opcional: e-mail quando alguém reporta bug (requer SMTP acima).
BUG_REPORT_EMAIL=

# Somente produção (exige rodar collectstatic no deploy)
USE_MANIFEST_STATIC=True
SECURE_SSL_REDIRECT=True
USE_X_FORWARDED_PROTO=True
SECURE_HSTS_SECONDS=31536000
